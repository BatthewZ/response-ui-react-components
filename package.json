{
  "name": "@batthewz/response-ui-react-components",
  "version": "0.18.0",
  "type": "module",
  "description": "React component library for the response-ui design system. Pairs with @batthewz/response-ui-css.",
  "sideEffects": false,
  "files": [
    "dist",
    "src",
    "docs",
    "!docs/project-docs",
    "AGENTS.md",
    "CHANGELOG.md",
    "README.md",
    "LICENSE"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./styles": "./dist/styles.css",
    "./examples/theme-tuning": {
      "style": "./src/examples/example-theme-tuning.css",
      "default": "./src/examples/example-theme-tuning.css"
    },
    "./examples/*": {
      "types": "./dist/examples/*.d.ts",
      "import": "./dist/examples/*.js"
    },
    "./components/*": {
      "types": "./dist/components/*.d.ts",
      "import": "./dist/components/*.js"
    },
    "./hooks/*": {
      "types": "./dist/hooks/*.d.ts",
      "import": "./dist/hooks/*.js"
    },
    "./util/style": {
      "types": "./dist/util/style.d.ts",
      "import": "./dist/util/style.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "dev": "vite --config dev/vite.config.ts",
    "site:dev": "vite --config site/vite.config.ts",
    "site:build": "vite build --config site/vite.config.ts",
    "site:preview": "vite preview --config site/vite.config.ts",
    "build": "vite build",
    "prepack": "bun run build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "test": "vitest run",
    "test:watch": "vitest",
    "docs:examples": "node scripts/gen-docs.mjs",
    "verify:directives": "node scripts/verify-directives.mjs",
    "verify:docs": "node scripts/verify-docs.mjs",
    "verify:examples": "node scripts/gen-docs.mjs --check",
    "verify:component-docs": "node scripts/verify-component-docs.mjs",
    "verify:focus-affordance": "node scripts/verify-focus-affordance.mjs",
    "verify:no-css-imports": "node scripts/verify-no-css-imports.mjs",
    "verify:css-layering": "node scripts/verify-css-layering.mjs",
    "verify:token-mirror": "node scripts/verify-token-mirror.mjs",
    "verify:omit-discipline": "node scripts/verify-omit-discipline.mjs --check",
    "verify:chart-palette": "node scripts/verify-chart-palette.mjs --check",
    "verify:example-themes": "node scripts/verify-example-themes.mjs --check",
    "verify:slot-annotations": "node scripts/verify-slot-annotations.mjs",
    "verify:scrollport-containing-block": "node scripts/verify-scrollport-containing-block.mjs",
    "verify:bugs": "node scripts/bugs-ledger.mjs --check",
    "probe:cascade-layer": "node scripts/probe-cascade-layer.mjs",
    "probe:scrollport": "node scripts/probe-scrollport-containing-block.mjs",
    "probe:floating-in-dialog": "node scripts/probe-floating-in-dialog.mjs",
    "prepublishOnly": "bun run build && node scripts/verify-directives.mjs && node scripts/verify-docs.mjs && node scripts/gen-docs.mjs --check && node scripts/verify-component-docs.mjs && node scripts/verify-focus-affordance.mjs && node scripts/verify-no-css-imports.mjs && node scripts/verify-css-layering.mjs && node scripts/verify-token-mirror.mjs && node scripts/verify-omit-discipline.mjs --check && node scripts/verify-chart-palette.mjs --check && node scripts/verify-example-themes.mjs --check && node scripts/verify-slot-annotations.mjs && node scripts/verify-scrollport-containing-block.mjs && bun run lint && bun run typecheck && bun run test",
    "verify:site": "node scripts/verify-site.mjs"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "@floating-ui/react": "^0.27.0",
    "lucide-react": ">=0.500.0 <2.0.0"
  },
  "dependencies": {
    "@batthewz/response-ui-css": "^0.14.0",
    "@batthewz/response-ui-tw-merge": "^0.1.3",
    "clsx": "^2.1.1",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@floating-ui/react": "0.27.20",
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/jest-dom": "6.10.0",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.1",
    "@types/node": "25.3.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitejs/plugin-react": "6.0.5",
    "ajv": "8.20.0",
    "eslint": "10.8.0",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "glob": "13.0.6",
    "jsdom": "29.1.1",
    "lucide-react": "0.564.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "typescript": "5.9.3",
    "typescript-eslint": "8.65.0",
    "vite": "8.2.0",
    "vite-plugin-dts": "4.5.4",
    "vitest": "4.1.10"
  },
  "keywords": [
    "design-system",
    "react",
    "ui",
    "components",
    "tailwind",
    "tailwindcss-v4"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/BatthewZ/response-ui-react-components.git"
  },
  "homepage": "https://github.com/BatthewZ/response-ui-react-components#readme",
  "bugs": "https://github.com/BatthewZ/response-ui-react-components/issues",
  "author": "BatthewZ"
}
